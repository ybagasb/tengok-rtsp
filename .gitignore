# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Template variabel lingkungan (tanpa nilai) boleh di-commit.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# streams
public/streams/
public/streams/*

docker-compose.yml

# editor / IDE
.kiro/

# workflow run artifacts (plan/review output)
.agents/

# file data sumber (kerja, bukan bagian aplikasi)
*.xlsx
*.pptx
*.zip
*.rar
internal-docs/
scripts/data/*.local.json

screenshots/
.auth/
