# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.
# Prefix NEXT_PUBLIC_ = terbaca di browser; sisanya hanya di server.

# --- Database ---
MONGODB_URI=

# --- Akses viewer (login PIN) ---
APP_PIN=
# Jumlah digit PIN, untuk indikator titik & keypad di halaman login.
# Harus sama dengan panjang APP_PIN. Kosong/tidak valid = 6.
NEXT_PUBLIC_PIN_LENGTH=
# Kirim PIN otomatis saat jumlah digit tercapai (1 = aktif). Default mati:
# login PIN dibatasi 5 percobaan/menit/IP, auto-submit membakar kuota.
# Aktifkan hanya untuk pemasangan kiosk/TV lobi.
NEXT_PUBLIC_PIN_AUTOSUBMIT=

# Kontak bantuan yang tampil di halaman login ("Lupa PIN? Hubungi admin").
# Kosong = hanya teks tanpa tautan.
NEXT_PUBLIC_HELP_CONTACT=

# --- SSO Cognito (NextAuth v5) ---
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Daftar cognito_sub super-admin permanen (pisah koma).
TENGOK_BOOTSTRAP_ADMIN_SUBS=

# --- Peta (opsional; kosong = fallback OpenFreeMap) ---
NEXT_PUBLIC_MAPTILER_KEY=

# --- Storage file proyek (MinIO/S3). Kosong = fitur upload nonaktif ---
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=
MINIO_REGION=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# --- Direktori user SSO (Postgres, read-only; opsional) ---
# SSO_PG_HOST=
# SSO_PG_DATABASE=
# SSO_PG_USER=
# SSO_PG_PASSWORD=
# SSO_PG_PORT=
# SSO_PG_SSL=
