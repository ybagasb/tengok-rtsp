# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.
# Prefix NEXT_PUBLIC_ = terbaca di browser; sisanya hanya di server.

# --- Database ---
MONGODB_URI=

# --- Akses viewer (login PIN) ---
APP_PIN=

# --- SSO Cognito (NextAuth v5) ---
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Daftar cognito_sub super-admin permanen (pisah koma).
TENGOK_BOOTSTRAP_ADMIN_SUBS=

# --- Peta (opsional; kosong = fallback OpenFreeMap) ---
NEXT_PUBLIC_MAPTILER_KEY=

# --- Storage file proyek (MinIO/S3). Kosong = fitur upload nonaktif ---
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=
MINIO_REGION=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# --- Direktori user SSO (Postgres, read-only; opsional) ---
# SSO_PG_HOST=
# SSO_PG_DATABASE=
# SSO_PG_USER=
# SSO_PG_PASSWORD=
# SSO_PG_PORT=
# SSO_PG_SSL=
